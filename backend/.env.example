# Copy to .env for local development. On Render, set these in the dashboard.

# Local:  postgresql+psycopg://postgres:<url-encoded-password>@localhost:5432/fitai_db
# Neon:   paste the connection string as-is (postgresql://...?sslmode=require); the
#         app switches it to the psycopg driver automatically.
DATABASE_URL=

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
AI_DAILY_LIMIT=40

# Comma-separated frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: also allow Vercel preview URLs, e.g. https://fitai-.*\.vercel\.app
CORS_ORIGIN_REGEX=
